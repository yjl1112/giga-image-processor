# 运行端口 / 监听地址
KROWORK_PORT=5003
KROWORK_HOST=127.0.0.1

# 访问令牌门禁（shared/auth.py）。留空则不校验；可同时写入仓库根目录 config/.env
# KROWORK_ACCESS_TOKEN=
# KROWORK_SESSION_SECRET=

# 图片处理参数（脚本默认 1600 / 85，可被单次请求覆盖）
# MATERIAL_RETENTION_DAYS=1
# MATERIAL_RETENTION_INTERVAL_SECONDS=1800

# 公网访问（可选）：素材外链域名
# KROWORK_BASE_DOMAIN=example.com
# MATERIAL_PUBLIC_IMAGE_BASE_URL=

# GIGA 素材站点 / 下载通道
# GIGA_WEB_BASE_URL=https://www.gigab2b.com
# KIMI_WEBBRIDGE_URL=http://127.0.0.1:10086/command

# AGNES API（可选：局部编辑 + 提示词优化，不配置则这两项功能不可用）
# AGNES_API_KEY=
# AGNES_IMAGE_API_URL=https://apihub.agnes-ai.com/v1
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# AGNES_PROMPT_MODEL=agnes-2.5-flash

# 覆盖项目根 / Python 解释器（一般无需设置）
# BUNDLE_ROOT=.
# BUNDLE_PYTHON=python
